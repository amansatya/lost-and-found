# Copy this file to .env and fill in your details.

# The Gmail address you'll send OTP emails from
GMAIL_USER=youraddress@gmail.com

# A 16-character Google App Password (NOT your normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account first).
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Port the OTP server runs on
PORT=4000

# URL of the running frontend, so CORS allows it
FRONTEND_URL=http://localhost:5173
